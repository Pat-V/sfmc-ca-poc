
{
  "workflowApiVersion": "1.1",
  "metaData": {
    "icon": "ICON_URL_WEB_ADS",
    "category": "custom"
  },
  "type": "REST",
  "lang": {
    "en-US": {
      "name": "Web Ads",
      "description": "Pousse le HCP dans une audience publicitaire (PoC palette)"
    }
  },
  "arguments": {
    "execute": {
      "inArguments": [
        { "contactKey": "{{Contact.Key}}" }
      ],
      "url": "https://EXAMPLE.github.io/REPO/web-ads/execute",
      "verb": "POST",
      "useJwt": false,
      "timeout": 10000
    }
  },
  "configurationArguments": {
    "applicationExtensionKey": "REPLACE_WITH_WEB_ADS_PACKAGE_UNIQUE_KEY"
  },
  "userInterfaces": {
    "configModal": {
      "url": "https://EXAMPLE.github.io/REPO/web-ads/ui",
      "height": 400,
      "width": 600
    }
  }
}
